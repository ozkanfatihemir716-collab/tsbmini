local function createToggle(label, defaultState, callback)
    local row = Instance.new("TextButton")
    row.Size = UDim2.new(1, 0, 0, 42)
    row.BackgroundColor3 = Settings.Card
    row.AutoButtonColor = false
    row.Text = ""
    row.Active = true
    row.Selectable = true
    row.Parent = Scroll
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -60, 1, 0)
    lbl.Position = UDim2.new(0, 14, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.TextColor3 = Settings.Text
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Active = false
    lbl.Parent = row

    local track = Instance.new("Frame")
    track.Size = UDim2.new(0, 36, 0, 20)
    track.Position = UDim2.new(1, -50, 0.5, -10)
    track.BackgroundColor3 = Settings.Border
    track.Active = false
    track.Parent = row
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.Position = UDim2.new(0, 2, 0.5, -8)
    knob.BackgroundColor3 = Settings.Muted
    knob.Active = false
    knob.Parent = track
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local state = defaultState
    local function update(animate)
        local info = animate and TweenInfo.new(0.15, Enum.EasingStyle.Quad) or TweenInfo.new(0)
        if state then
            TweenService:Create(track, info, {BackgroundColor3 = Settings.Accent}):Play()
            TweenService:Create(knob, info, {
                Position = UDim2.new(1, -18, 0.5, -8),
                BackgroundColor3 = Settings.Text
            }):Play()
        else
            TweenService:Create(track, info, {BackgroundColor3 = Settings.Border}):Play()
            TweenService:Create(knob, info, {
                Position = UDim2.new(0, 2, 0.5, -8),
                BackgroundColor3 = Settings.Muted
            }):Play()
        end
    end
    onClick(row, function()
        state = not state
        update(true)
        if callback then pcall(callback, state) end
    end)
    update(false)
end

