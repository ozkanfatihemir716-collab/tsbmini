    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Active = false
    lbl.Parent = row

    local valueLbl = Instance.new("TextLabel")
    valueLbl.Size = UDim2.new(0, 60, 0, 20)
    valueLbl.Position = UDim2.new(1, -74, 0, 8)
    valueLbl.BackgroundTransparency = 1
    valueLbl.Text = tostring(default) .. (suffix or "")
    valueLbl.TextColor3 = Settings.Accent
    valueLbl.Font = Enum.Font.GothamBold
    valueLbl.TextSize = 12
    valueLbl.TextXAlignment = Enum.TextXAlignment.Right
    valueLbl.Active = false
    valueLbl.Parent = row

    local track = Instance.new("TextButton")
    track.Size = UDim2.new(1, -28, 0, 8)
    track.Position = UDim2.new(0, 14, 0, 36)
    track.BackgroundColor3 = Settings.Border
    track.AutoButtonColor = false
    track.Text = ""
    track.Active = true
    track.Selectable = true
    track.Parent = row
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((default - minV) / (maxV - minV), 0, 1, 0)
    fill.BackgroundColor3 = Settings.Accent
    fill.BorderSizePixel = 0
    fill.Active = false
    fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local handle = Instance.new("Frame")
    handle.Size = UDim2.new(0, 16, 0, 16)
    handle.Position = UDim2.new(1, -8, 0.5, -8)
    handle.BackgroundColor3 = Settings.Text
    handle.ZIndex = 5
    handle.Active = false
    handle.Parent = fill
    Instance.new("UICorner", handle).CornerRadius = UDim.new(1, 0)

    local function setV(v)
        v = math.clamp(v, minV, maxV)
        fill.Size = UDim2.new((v - minV) / (maxV - minV), 0, 1, 0)
        valueLbl.Text = tostring(math.floor(v * 10) / 10) .. (suffix or "")
        if callback then pcall(callback, v) end
    end

    local sliderDragging = false
    local function updateFromInput(input)
        local ap = track.AbsolutePosition
        local as = track.AbsoluteSize
        if as.X <= 0 then return end
        local x = input.Position.X - ap.X
        setV(minV + (maxV - minV) * math.clamp(x / as.X, 0, 1))
    end
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliderDragging = true
            updateFromInput(input)
            local conn
            conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    sliderDragging = false
                    if conn then conn:Disconnect() end
                end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not sliderDragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            updateFromInput(input)
        end
    end)
end

