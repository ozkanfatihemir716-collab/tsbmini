fpsText.BackgroundColor3 = Settings.Card
fpsText.Text = "60 FPS"
fpsText.TextColor3 = Settings.Muted
fpsText.Font = Enum.Font.GothamBold
fpsText.TextSize = 12
fpsText.Active = false
fpsText.Parent = Scroll
Instance.new("UICorner", fpsText).CornerRadius = UDim.new(0, 8)

-- ==================== FPS + MAIN LOOP ====================
local fps, frameCount, timeAccum = 60, 0, 0

RunService.Heartbeat:Connect(function(dt)
    frameCount = frameCount + 1
    timeAccum = timeAccum + dt
    if timeAccum >= 1 then
        fps = math.floor(frameCount / timeAccum)
        frameCount = 0
        timeAccum = 0

        -- FPS rengi
        if fps >= 50 then
            fpsText.TextColor3 = Settings.Muted
        elseif fps >= 30 then
            fpsText.TextColor3 = Settings.Amber
        else
            fpsText.TextColor3 = Color3.fromRGB(248, 113, 113)
        end

        local perfLabel = PerfState.active and " [PERF]" or ""
        fpsText.Text = fps .. " FPS" .. perfLabel

        -- Idle durumu
        if Idle.active then
            statusDot.BackgroundColor3 = Settings.Amber
            statusLabel.Text = "IDLE"
            statusLabel.TextColor3 = Settings.Amber
        else
            statusDot.BackgroundColor3 = Settings.Green
            statusLabel.Text = "ACTIVE"
            statusLabel.TextColor3 = Settings.Green
        end

        -- Otomatik perf boost
        updatePerfBoost(fps)
    end

    updateIdle(dt)
    enforceWalkSpeed()
    pcall(tryNoRagdoll)
    pcall(tryAutoBackStep)
end)

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    Idle.timer = 0
    backStepCooldownUntil = tick() + 2
    if not Idle.active then
        enforceWalkSpeed()
        tryNoRagdoll()
    end
end)

print("[NOVE v8] Loaded | PerfBoost: FPS<10")
