local function onClick(btn, fn)
    local last = 0
    local function fire()
        if tick() - last < 0.2 then return end
        last = tick()
        pcall(fn)
    end
    pcall(function() btn.Activated:Connect(fire) end)
    pcall(function() btn.MouseButton1Click:Connect(fire) end)
end

-- ==================== YUMUŞAK PERFORMANS BOOST ====================
-- Sadece FPS < 10 olunca devreye girer, haritayı bozmaz
local function enablePerfBoost()
    if PerfState.active then return end
    PerfState.active = true
    PerfState.savedQuality = settings().Rendering.QualityLevel
    PerfState.savedShadows = Lighting.GlobalShadows
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.ShadowSoftness = 0
        Lighting.EnvironmentDiffuseScale = 0.1
        Lighting.EnvironmentSpecularScale = 0.1
        for _, obj in ipairs(Lighting:GetChildren()) do
            if obj:IsA("PostEffect") and obj.Enabled then
                obj.Enabled = false
                obj:SetAttribute("NOVE_disabled", true)
            end
        end
        local t = workspace:FindFirstChildOfClass("Terrain")
        if t then
            t.WaterWaveSize = 0
            t.WaterWaveSpeed = 0
            t.WaterReflectance = 0
        end
    end)
end

local function disablePerfBoost()
    if not PerfState.active then return end
    PerfState.active = false
    pcall(function()
        if PerfState.savedQuality then
            settings().Rendering.QualityLevel = PerfState.savedQuality
        end
    end)
    pcall(function()
        if PerfState.savedShadows ~= nil then
            Lighting.GlobalShadows = PerfState.savedShadows
        end
        for _, obj in ipairs(Lighting:GetChildren()) do
            if obj:IsA("PostEffect") and obj:GetAttribute("NOVE_disabled") then
                obj.Enabled = true
                obj:SetAttribute("NOVE_disabled", nil)
            end
        end
    end)
end

-- FPS'e göre otomatik tetikleme
local function updatePerfBoost(currentFps)
    if not G.PerfBoost then
        if PerfState.active then disablePerfBoost() end
        return
    end
    if PerfState.active then
        -- FPS 25'in üzerine çıkarsa kapat
        if currentFps >= Settings.PerfFpsRecover then
            disablePerfBoost()
        end
    else
        -- FPS 10'un altına düşerse aç
        if currentFps > 0 and currentFps < Settings.PerfFpsThreshold then
            enablePerfBoost()
        end
    end
end

-- ==================== IDLE AI ====================
local function isPlayerMoving()
    local hrp = getHRP()
    local hum = getHum()
    if hrp and hrp.AssemblyLinearVelocity.Magnitude > 1 then return true end
    if hum and hum.MoveDirection.Magnitude > 0.1 then return true end
    for _, k in ipairs({Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D, Enum.KeyCode.Space}) do
        if UserInputService:IsKeyDown(k) then return true end
    end
    return false
end

local function suspendAll()
    if Idle.active then return end
    Idle.active = true
    Idle.savedStates = {}
    for k, v in pairs(G) do
        Idle.savedStates[k] = v
        G[k] = false
    end
    local hum = getHum()
    if hum then
        pcall(function() hum.WalkSpeed = 16 end)
        pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
        end)
    end
end

local function resumeAll()
    if not Idle.active then return end
    Idle.active = false
    for k, v in pairs(Idle.savedStates) do G[k] = v end
    Idle.savedStates = {}
    local hum = getHum()
    if hum and G.WalkSpeed then
        pcall(function() hum.WalkSpeed = Settings.WalkSpeed end)
    end
end

local function updateIdle(dt)
    if isPlayerMoving() then
        Idle.timer = 0
        if Idle.active then resumeAll() end
    else
        Idle.timer = Idle.timer + dt
        if Idle.timer >= Settings.IdleThreshold and not Idle.active then
            suspendAll()
        end
    end
end

-- ==================== WALKSPEED ====================
local function enforceWalkSpeed()
    if Idle.active then return end
    if not G.WalkSpeed then return end
    local hum = getHum()
    if hum and math.abs(hum.WalkSpeed - Settings.WalkSpeed) > 0.1 then
        pcall(function() hum.WalkSpeed = Settings.WalkSpeed end)
    end
end

-- ==================== NO RAGDOLL ====================
local function tryNoRagdoll()
    if Idle.active then return end
    if not G.NoRagdoll then return end
    local hum = getHum()
    if not hum then return end
    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        if hum.PlatformStand then hum.PlatformStand = false end
    end)
end

-- ==================== AUTO BACK STEP ====================
local function getClosestEnemy(maxDist)
    local myHRP = getHRP()
    if not myHRP then return nil end
    local closest, minD = nil, maxDist
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and hrp then
                local d = (myHRP.Position - hrp.Position).Magnitude
                if d < minD then minD = d; closest = p end
            end
        end
    end
    return closest
end

local backStepCooldownUntil = 0
local function tryAutoBackStep()
    if Idle.active then return end
    if not G.AutoBackStep then return end
    if tick() < backStepCooldownUntil then return end
    local myHRP = getHRP()
    if not myHRP then return end
    local enemy = getClosestEnemy(Settings.BackStepRange)
    if not enemy or not enemy.Character then return end
    local tHRP = enemy.Character:FindFirstChild("HumanoidRootPart")
    if not tHRP then return end
    local look = tHRP.CFrame.LookVector
    local backDir = -Vector3.new(look.X, 0, look.Z)
    if backDir.Magnitude < 0.01 then return end
    backDir = backDir.Unit
    local dist = math.max(Settings.BackStepDist, 1)
    local targetPos = tHRP.Position + backDir * dist
    targetPos = Vector3.new(targetPos.X, myHRP.Position.Y, targetPos.Z)
    pcall(function()
        myHRP.CFrame = CFrame.lookAt(targetPos, tHRP.Position)
    end)
    backStepCooldownUntil = tick() + Settings.BackStepCooldown
end

